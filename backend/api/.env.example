JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Required only when the database has zero users.
# The backend creates this account as the first admin, then ignores these values
# on later starts once at least one user exists.
HERA_ADMIN_EMAIL=admin@example.com
HERA_ADMIN_USERNAME=admin
HERA_ADMIN_PASSWORD=replace-with-a-strong-password
